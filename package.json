{
  "name": "wildlife-id",
  "version": "1.0.0",
  "description": "Offline desktop app for animal species identification using BioCLIP",
  "main": "dist/main/index.js",
  "author": "Jego-M",
  "license": "MIT",
  "private": false,
  "scripts": {
    "dev": "tsc -p tsconfig.main.json && concurrently -k -n vite,main,electron -c cyan,yellow,blue \"vite\" \"tsc -p tsconfig.main.json --watch\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:backend": "bash build/build_backend.sh",
    "test": "vitest run",
    "test:backend": "pytest src/backend/",
    "lint": "eslint src",
    "lint:backend": "cd src/backend && ruff check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.main.json",
    "dist": "npm run build && electron-builder --config build/electron-builder.yml",
    "rebuild": "electron-rebuild -f -w better-sqlite3 --runtime electron --target 33.4.11 --dist-url https://electronjs.org/headers"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "electron-log": "^5.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.0",
    "eslint": "^9.0.0",
    "sass": "^1.79.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "wait-on": "^7.2.0"
  }
}
